{
  "$id": "https://aief.dev/schemas/project-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The narrowest knowledge layer: this repository's parameters.",
  "properties": {
    "foundation": {
      "additionalProperties": false,
      "properties": {
        "conformance": {
          "enum": [
            "core",
            "full"
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "conformance"
      ],
      "type": "object"
    },
    "governance": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": [
            "string",
            "null"
          ]
        },
        "waivers": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "propertyNames": {
            "enum": [
              "format",
              "lint",
              "typecheck",
              "test",
              "architecture_check",
              "contract_check",
              "secret_scan",
              "dependency_audit"
            ]
          },
          "type": "object"
        },
        "signals": {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "risk_flags": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "project_specific": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-\\d{3,}$",
            "type": "string"
          },
          "mode": {
            "enum": [
              "enforced",
              "advisory",
              "off"
            ]
          },
          "scope": {
            "description": "Where the rule applies. Absent means repository-wide.",
            "oneOf": [
              {
                "const": "global"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "exclude": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "include": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": {
                    "enum": [
                      "paths",
                      "module",
                      "component",
                      "directory",
                      "language",
                      "file-type",
                      "repository-area"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stacks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "project",
    "foundation"
  ],
  "title": "AIEF Project Profile",
  "type": "object"
}
